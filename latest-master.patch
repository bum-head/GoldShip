+        {% for r in regions %}
+            <option value="{{ r.pk }}" {% if selected == r.pk %}selected{% endif %}>{{ r }}</option>
+        {% endfor %}
+    </select>
+    <button type="submit">Filter</button>
+</form>
+
+{% for item in items %}

@@ -0,0 +1,285 @@
+/*
+ * NetAgri climate logic: weather lookup + rain / flood alert evaluation.
+ *
+ * No DOM access in here, so it can be unit-tested in Node
+ * (see pages/static/pages/climate.test.js).
+ *
+ * Data: Open-Meteo (https://open-meteo.com) - free for NON-COMMERCIAL use, no API key.
+ *   forecast : https://api.open-meteo.com/v1/forecast
+ *   flood    : https://flood-api.open-meteo.com/v1/flood   (GloFAS river discharge)
+ * Switch to a commercial plan / another provider before this is used commercially.
+ */
+(function (root, factory) {
+  if (typeof module === "object" && module.exports) module.exports = factory();
+  else root.NetAgriClimate = factory();
+})(typeof self !== "undefined" ? self : this, function () {
+  "use strict";
+
+  /* ---------------------------------------------------------------- *
+   * Thresholds. Rainfall classes follow the IMD 24-hour categories:
+   *   heavy 64.5-115.5 mm, very heavy 115.6-204.4 mm, extremely heavy >= 204.5 mm
+   * Everything else is a heuristic and should be tuned with local data.
+   * ---------------------------------------------------------------- */
+  const T = {
+    heavy24: 64.5,
+    veryHeavy24: 115.6,
+    extremeHeavy24: 204.5,
+    intenseHour: 20, // mm in one hour
+    rainLikelyProb: 60, // %
+    rainLikelyMm48: 10, // mm over 48 h
+    floodRain72Extreme: 250, // mm over 72 h - flood warning on rainfall alone
+    floodRain72High: 150, // mm over 72 h
+    floodRain72Mid: 100,
+    saturatedSoil: 0.35, // m3/m3 (top 1 cm) - ground can't absorb more
+    riverRiseHigh: 2.0, // forecast peak / today's discharge
+    riverRiseMid: 1.4,
+    minRiverDischarge: 5, // m3/s; below this the 5 km model grid is not a real river
+  };
+
+  /* WMO weather codes -> [label, icon] */
+  const WMO = {
+    0: ["Clear sky", "☀️"], 1: ["Mainly clear", "🌤️"], 2: ["Partly cloudy", "⛅"], 3: ["Overcast", "☁️"],
+    45: ["Fog", "🌫️"], 48: ["Rime fog", "🌫️"],
+    51: ["Light drizzle", "🌦️"], 53: ["Drizzle", "🌦️"], 55: ["Dense drizzle", "🌦️"],
+    56: ["Freezing drizzle", "🌧️"], 57: ["Freezing drizzle", "🌧️"],
+    61: ["Light rain", "🌦️"], 63: ["Rain", "🌧️"], 65: ["Heavy rain", "🌧️"],
+    66: ["Freezing rain", "🌧️"], 67: ["Freezing rain", "🌧️"],
+    71: ["Light snow", "🌨️"], 73: ["Snow", "🌨️"], 75: ["Heavy snow", "❄️"], 77: ["Snow grains", "🌨️"],
+    80: ["Light showers", "🌦️"], 81: ["Showers", "🌧️"], 82: ["Violent showers", "⛈️"],
+    85: ["Snow showers", "🌨️"], 86: ["Heavy snow showers", "❄️"],
+    95: ["Thunderstorm", "⛈️"], 96: ["Thunderstorm, hail", "⛈️"], 99: ["Severe thunderstorm, hail", "⛈️"],
+  };
+
+  function describe(code) {
+    const e = WMO[code];
+    return e ? { label: e[0], icon: e[1] } : { label: "Unknown", icon: "❔" };
+  }
+
+  /* ------------------------------ geography ------------------------------ */
+
+  function haversineKm(lat1, lon1, lat2, lon2) {
+    const R = 6371, rad = Math.PI / 180;
+    const dLat = (lat2 - lat1) * rad, dLon = (lon2 - lon1) * rad;
+    const a = Math.sin(dLat / 2) ** 2 +
+      Math.cos(lat1 * rad) * Math.cos(lat2 * rad) * Math.sin(dLon / 2) ** 2;
+    return 2 * R * Math.asin(Math.sqrt(a));
+  }
+
+  function inBounds(lat, lon, b) {
+    return lat >= b.south && lat <= b.north && lon >= b.west && lon <= b.east;
+  }
+
+  /** Nearest known NER place to a coordinate: {name, state, km} or null. */
+  function nearestPlace(lat, lon, states) {
+    let best = null;
+    for (const s of states) {
+      for (const p of s.places) {
+        const km = haversineKm(lat, lon, p.lat, p.lon);
+        if (!best || km < best.km) best = { name: p.name, state: s.name, km };
+      }
+    }
+    return best;
+  }
+
+  /* -------------------------------- fetching ------------------------------ */
+
+  const FORECAST_URL = "https://api.open-meteo.com/v1/forecast";
+  const FLOOD_URL = "https://flood-api.open-meteo.com/v1/flood";
+
+  function qs(params) {
+    return Object.entries(params).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join("&");
+  }
+
+  async function getJson(url, timeoutMs, fetchImpl) {
+    const ctl = typeof AbortController !== "undefined" ? new AbortController() : null;
+    const timer = ctl ? setTimeout(() => ctl.abort(), timeoutMs) : null;
+    try {
+      const res = await fetchImpl(url, ctl ? { signal: ctl.signal } : undefined);
+      if (!res.ok) throw new Error(`HTTP ${res.status}`);
+      return await res.json();
+    } finally {
+      if (timer) clearTimeout(timer);
+    }
+  }
+
+  /**
+   * Fetch forecast (required) and river-flood data (optional) for a point.
+   * Resolves { forecast, flood|null }. Rejects only if the forecast fails.
+   */
+  async function fetchWeather(lat, lon, fetchImpl) {
+    fetchImpl = fetchImpl || (typeof fetch !== "undefined" ? fetch.bind(globalThis) : null);
+    const fUrl = FORECAST_URL + "?" + qs({
+      latitude: lat.toFixed(4),
+      longitude: lon.toFixed(4),
+      current: "temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m,wind_gusts_10m",
+      hourly: "precipitation,precipitation_probability,soil_moisture_0_to_1cm",
+      daily: "weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max",
+      timezone: "auto",
+      forecast_days: 7,
+    });
+    const rUrl = FLOOD_URL + "?" + qs({
+      latitude: lat.toFixed(4),
+      longitude: lon.toFixed(4),
+      daily: "river_discharge,river_discharge_max",
+      forecast_days: 7,
+    });
+    const [forecast, flood] = await Promise.all([
+      getJson(fUrl, 12000, fetchImpl),
+      getJson(rUrl, 12000, fetchImpl).catch(() => null), // flood data is a bonus, never fatal
+    ]);
+    return { forecast, flood };
+  }
+
+  /* ------------------------------- evaluation ----------------------------- */
+
+  const sum = (arr) => arr.reduce((a, v) => a + (v || 0), 0);
+  const max = (arr) => arr.reduce((a, v) => (v != null && v > a ? v : a), 0);
+  const round1 = (n) => Math.round(n * 10) / 10;
+
+  /** Index in hourly.time of the current hour (times are local ISO strings). */
+  function currentHourIndex(hourly, currentTime) {
+    const hour = (currentTime || "").slice(0, 13); // "2026-10-10T18"
+    const i = hourly.time.findIndex((t) => t.slice(0, 13) >= hour);
+    return i === -1 ? 0 : i;
+  }
+
+  /** Rolling summary used by both the alerts and the dashboard widgets. */
+  function summarise(forecast) {
+    const h = forecast.hourly;
+    const i = currentHourIndex(h, forecast.current && forecast.current.time);
+    const win = (arr, n) => arr.slice(i, i + n);
+
+    const p24 = win(h.precipitation, 24), p48 = win(h.precipitation, 48), p72 = win(h.precipitation, 72);
+    const prob24 = win(h.precipitation_probability || [], 24);
+    const prob48 = win(h.precipitation_probability || [], 48);
+
+    let peakIdx = i, peakVal = -1;
+    p48.forEach((v, k) => { if ((v || 0) > peakVal) { peakVal = v || 0; peakIdx = i + k; } });
+
+    const soil = (h.soil_moisture_0_to_1cm || [])[i];
+    let firstRain = null; // first hour with >= 0.5 mm
+    for (let k = 0; k < p72.length; k++) {
+      if ((p72[k] || 0) >= 0.5) { firstRain = h.time[i + k]; break; }
+    }
+
+    return {
+      startIndex: i,
+      rain24: round1(sum(p24)),
+      rain48: round1(sum(p48)),
+      rain72: round1(sum(p72)),
+      probMax24: max(prob24),
+      probMax48: max(prob48),
+      peakHourMm: round1(Math.max(peakVal, 0)),
+      peakHourTime: peakVal > 0 ? h.time[peakIdx] : null,
+      firstRain,
+      soilMoisture: soil == null ? null : soil,
+    };
+  }
+
+  /** River status from flood API data: {todayQ, peakQ, peakDate, ratio} or null. */
+  function riverStatus(flood) {
+    if (!flood || !flood.daily || !flood.daily.river_discharge) return null;
+    const q = flood.daily.river_discharge, t = flood.daily.time;
+    const valid = q.map((v, k) => [v, k]).filter(([v]) => v != null);
+    if (valid.length < 2) return null;
+    const todayQ = valid[0][0];
+    let peakQ = todayQ, peakK = valid[0][1];
+    for (const [v, k] of valid) if (v > peakQ) { peakQ = v; peakK = k; }
+    if (todayQ < T.minRiverDischarge && peakQ < T.minRiverDischarge) return null;
+    return {
+      todayQ: round1(todayQ),
+      peakQ: round1(peakQ),
+      peakDate: t[peakK],
+      ratio: todayQ > 0 ? round1(peakQ / todayQ) : null,
+    };
+  }
+
+  const LEVELS = { advisory: 1, watch: 2, warning: 3 };
+
+  const ACTIONS = {
+    rain: [
+      "Harvest mature crops before the rain and move produce under cover.",
+      "Clear field drains and channels so water can leave the plot.",
+      "Hold off fertiliser and pesticide spraying - rain will wash it away.",
+      "Secure livestock, tools and covered storage.",
+    ],
+    heavy: [
+      "Bring harvested produce, seed and fertiliser into dry, raised storage.",
+      "Open drainage channels and check bunds on low-lying fields.",
+      "Check road and bridge status before sending produce to market.",
+      "Keep phones charged and a battery torch ready.",
+    ],
+    flood: [
+      "Move stored grain, seed and inputs above ground level.",
+      "Identify the nearest higher ground or relief shelter and a route to it.",
+      "Move livestock and equipment to safe ground early.",
+      "Delay dispatching produce along low-lying roads and river crossings.",
+      "Follow official warnings: IMD, Central Water Commission, state disaster authority.",
+    ],
+  };
+
+  /**
+   * Turn a forecast (+ optional flood data) into alerts.
+   * Returns { summary, river, alerts[], topLevel } where each alert is
+   * { id, kind, level, title, detail, actions[] } and topLevel is
+   * "none" | "advisory" | "watch" | "warning".
+   */
+  function evaluate(forecast, flood) {
+    const s = summarise(forecast);
+    const river = riverStatus(flood);
+    const alerts = [];
+
+    /* ---- rain ---- */
+    let rainLevel = null, rainTitle = "";
+    if (s.rain24 >= T.extremeHeavy24) { rainLevel = "warning"; rainTitle = "Extremely heavy rain expected"; }
+    else if (s.rain24 >= T.veryHeavy24) { rainLevel = "warning"; rainTitle = "Very heavy rain expected"; }
+    else if (s.rain24 >= T.heavy24) { rainLevel = "watch"; rainTitle = "Heavy rain expected"; }
+    else if (s.peakHourMm >= T.intenseHour) { rainLevel = "watch"; rainTitle = "Intense downpour possible"; }
+    else if (s.probMax48 >= T.rainLikelyProb && s.rain48 >= T.rainLikelyMm48) { rainLevel = "advisory"; rainTitle = "Rain likely"; }
+
+    if (rainLevel) {
+      const bits = [`${s.rain24} mm in the next 24 h`, `${s.rain72} mm over 72 h`];
+      if (s.peakHourMm >= 5) bits.push(`peak about ${s.peakHourMm} mm/h`);
+      alerts.push({
+        id: "rain-" + rainLevel,
+        kind: "rain",
+        level: rainLevel,
+        title: rainTitle,
+        detail: bits.join(" · ") + (s.firstRain ? `. Rain starts around ${s.firstRain.slice(11, 16)} (${s.firstRain.slice(0, 10)}).` : "."),
+        actions: rainLevel === "advisory" ? ACTIONS.rain : ACTIONS.heavy,
+      });
+    }
+
+    /* ---- flood (score from independent signals) ---- */
+    let score = 0;
+    const why = [];
+    if (s.rain72 >= T.floodRain72Extreme) { score += 4; why.push(`${s.rain72} mm of rain forecast over 72 h`); }
+    else if (s.rain72 >= T.floodRain72High) { score += 2; why.push(`${s.rain72} mm of rain forecast over 72 h`); }
+    else if (s.rain72 >= T.floodRain72Mid) { score += 1; why.push(`${s.rain72} mm of rain forecast over 72 h`); }
+
+    if (s.soilMoisture != null && s.soilMoisture >= T.saturatedSoil && s.rain72 >= 60) {
+      score += 1; why.push("soil is already saturated");
+    }
+    if (river && river.ratio != null) {
+      if (river.ratio >= T.riverRiseHigh) { score += 2; why.push(`nearby river flow forecast to rise ${river.ratio}× (${river.todayQ} → ${river.peakQ} m³/s)`); }
+      else if (river.ratio >= T.riverRiseMid) { score += 1; why.push(`nearby river flow forecast to rise ${river.ratio}×`); }
+    }
+    if (score >= 2) {
+      const level = score >= 4 ? "warning" : score === 3 ? "watch" : "advisory";
+      alerts.push({
+        id: "flood-" + level,
+        kind: "flood",
+        level,
+        title: level === "warning" ? "High flood risk" : level === "watch" ? "Elevated flood risk" : "Possible flooding - stay alert",
+        detail: why.join("; ") + ". Model-based estimate, not an official warning.",
+        actions: ACTIONS.flood,
+      });
+    }
+
+    alerts.sort((a, b) => LEVELS[b.level] - LEVELS[a.level]);
+    const topLevel = alerts.length ? alerts[0].level : "none";
+    return { summary: s, river, alerts, topLevel, floodScore: score };
+  }
+
+  return { T, WMO, describe, haversineKm, inBounds, nearestPlace, fetchWeather, summarise, riverStatus, evaluate };
+});
diff --git a/NetAgri/pages/static/pages/climate.test.js b/NetAgri/pages/static/pages/climate.test.js
new file mode 100644
index 0000000..65360d8
--- /dev/null
+++ b/NetAgri/pages/static/pages/climate.test.js
@@ -0,0 +1,144 @@
+// Run with:  node pages/static/pages/climate.test.js   (from the NetAgri folder)
+const assert = require("node:assert/strict");
+const C = require("./climate.js");
+
+/** Build a fake Open-Meteo forecast: 168 hourly values from 2026-10-10T00:00. */
+function fake({ rain = () => 0, prob = () => 0, soil = 0.2, nowHour = 18 } = {}) {
+  const time = [];
+  for (let d = 0; d < 7; d++) for (let h = 0; h < 24; h++) {
+    time.push(`2026-10-${String(10 + d).padStart(2, "0")}T${String(h).padStart(2, "0")}:00`);
+  }
+  return {
+    current: { time: `2026-10-10T${String(nowHour).padStart(2, "0")}:15` },
+    hourly: {
+      time,
+      precipitation: time.map((_, i) => rain(i - nowHour)),
+      precipitation_probability: time.map((_, i) => prob(i - nowHour)),
+      soil_moisture_0_to_1cm: time.map(() => soil),
+    },
+  };
+}
+const flood = (q) => ({ daily: { time: q.map((_, i) => `2026-10-${10 + i}`), river_discharge: q } });
+let n = 0;
+const t = (name, fn) => { fn(); n++; console.log("ok -", name); };
+
+t("dry day: no alerts", () => {
+  const r = C.evaluate(fake());
+  assert.equal(r.topLevel, "none");
+  assert.equal(r.alerts.length, 0);
+});
+
+t("window starts at the current hour, not midnight", () => {
+  // 100 mm fell earlier today (hours 0-5) - must NOT count towards the forecast
+  const r = C.evaluate(fake({ rain: (rel) => (rel < -10 ? 20 : 0) }));
+  assert.equal(r.summary.rain24, 0);
+  assert.equal(r.topLevel, "none");
+});
+
+t("rain likely -> advisory", () => {
+  const r = C.evaluate(fake({ rain: (rel) => (rel >= 0 && rel < 6 ? 2 : 0), prob: () => 80 }));
+  assert.equal(r.topLevel, "advisory");
+  assert.equal(r.alerts[0].kind, "rain");
+});
+
+t("high probability but trivial rain -> no alert", () => {
+  const r = C.evaluate(fake({ rain: () => 0.1, prob: () => 90 }));
+  assert.equal(r.alerts.length, 0);
+});
+
+t("heavy rain (>=64.5 mm/24h) -> watch", () => {
+  const r = C.evaluate(fake({ rain: (rel) => (rel >= 0 && rel < 12 ? 6 : 0) })); // 72 mm
+  assert.equal(r.alerts[0].level, "watch");
+  assert.match(r.alerts[0].title, /Heavy rain/);
+});
+
+t("very heavy rain (>=115.6 mm/24h) -> warning", () => {
+  const r = C.evaluate(fake({ rain: (rel) => (rel >= 0 && rel < 12 ? 10 : 0) })); // 120 mm
+  assert.equal(r.alerts[0].level, "warning");
+});
+
+t("intense single hour -> watch", () => {
+  const r = C.evaluate(fake({ rain: (rel) => (rel === 3 ? 25 : 0) }));
+  assert.equal(r.alerts[0].level, "watch");
+  assert.match(r.alerts[0].title, /downpour/i);
+});
+
+t("flood: big 72h rain + saturated soil -> flood alert, sorted by severity", () => {
+  const r = C.evaluate(fake({ rain: (rel) => (rel >= 0 && rel < 36 ? 5 : 0), soil: 0.42 })); // 180 mm
+  const f = r.alerts.find((a) => a.kind === "flood");
+  assert.ok(f, "flood alert present");
+  assert.equal(f.level, "watch"); // 180 mm + saturated soil = score 3
+  assert.ok(f.detail.includes("not an official warning"));
+  assert.ok(f.actions.length > 0);
+  const order = r.alerts.map((a) => ["advisory", "watch", "warning"].indexOf(a.level));
+  assert.deepEqual(order, [...order].sort((a, b) => b - a));
+});
+
+t("flood: extreme 72h rainfall alone -> flood warning", () => {
+  const r = C.evaluate(fake({ rain: (rel) => (rel >= 0 && rel < 36 ? 7.5 : 0) })); // 270 mm
+  assert.equal(r.alerts.find((a) => a.kind === "flood").level, "warning");
+  assert.equal(r.topLevel, "warning");
+});
+
+t("flood: river surge alone (no local rain) still alerts - upstream flooding", () => {
+  const r = C.evaluate(fake(), flood([1000, 1400, 2300, 3000, 2800, 2500, 2000]));
+  assert.equal(r.river.ratio, 3);
+  const f = r.alerts.find((a) => a.kind === "flood");
+  assert.ok(f);
+  assert.equal(f.level, "advisory"); // river signal alone = score 2
+});
+
+t("flood: tiny stream (below model resolution) is ignored", () => {
+  const r = C.evaluate(fake(), flood([0.5, 1, 3, 4, 2, 1, 1]));
+  assert.equal(r.river, null);
+  assert.equal(r.alerts.length, 0);
+});
+
+t("flood: stable river + light rain -> nothing", () => {
+  const r = C.evaluate(fake({ rain: () => 0.2 }), flood([800, 810, 820, 800, 790, 780, 770]));
+  assert.equal(r.alerts.length, 0);
+});
+
+t("missing flood data / missing optional hourly fields don't crash", () => {
+  const fc = fake();
+  delete fc.hourly.precipitation_probability;
+  delete fc.hourly.soil_moisture_0_to_1cm;
+  assert.doesNotThrow(() => C.evaluate(fc, null));
+  assert.doesNotThrow(() => C.evaluate(fc, { daily: {} }));
+});
+
+t("null values in arrays are tolerated", () => {
+  const fc = fake({ rain: () => 1 });
+  fc.hourly.precipitation[20] = null;
+  assert.doesNotThrow(() => C.evaluate(fc, flood([null, null, 5, 9, null, 8, 8])));
+});
+
+t("nearestPlace / inBounds", () => {
+  const states = [{ name: "Assam", places: [{ name: "Jorhat", lat: 26.7509, lon: 94.2037 }, { name: "Guwahati", lat: 26.1445, lon: 91.7362 }] }];
+  const p = C.nearestPlace(26.76, 94.21, states);
+  assert.equal(p.name, "Jorhat");
+  assert.ok(p.km < 3);
+  const b = { south: 21.9, north: 29.5, west: 87.9, east: 97.5 };
+  assert.equal(C.inBounds(26.1, 91.7, b), true);
+  assert.equal(C.inBounds(28.6, 77.2, b), false); // Delhi
+});
+
+t("describe() handles known and unknown codes", () => {
+  assert.equal(C.describe(65).label, "Heavy rain");
+  assert.equal(C.describe(12345).label, "Unknown");
+});
+
+t("fetchWeather: flood API failure is non-fatal, forecast failure is fatal", async () => {});
+(async () => {
+  const ok = { ok: true, json: async () => ({ hello: 1 }) };
+  const r = await C.fetchWeather(26.14, 91.74, async (u) => {
+    if (u.includes("flood-api")) throw new Error("down");
+    assert.ok(u.includes("latitude=26.1400") && u.includes("timezone=auto"));
+    return ok;
+  });
+  assert.equal(r.flood, null);
+  assert.deepEqual(r.forecast, { hello: 1 });
+  await assert.rejects(C.fetchWeather(1, 2, async () => ({ ok: false, status: 500 })), /HTTP 500/);
+  console.log("ok - fetchWeather error handling");
+  console.log(`\n${n + 1} tests passed`);
+})();
diff --git a/NetAgri/pages/static/pages/dashboard.css b/NetAgri/pages/static/pages/dashboard.css
new file mode 100644
index 0000000..3e4968c
--- /dev/null
+++ b/NetAgri/pages/static/pages/dashboard.css
@@ -0,0 +1,194 @@
+/* NetAgri dashboard. Extends style.css (same greens, same card feel). */
+
+:root {
+    --green: #267447;
+    --green-dark: #204e34;
+    --ink: #25352a;
+    --muted: #627066;
+    --line: #e2e8df;
+    --card: #ffffff;
+
+    --ok-bg: #eaf6ee;       --ok-bd: #7cc596;       --ok-fg: #1d5a37;
+    --adv-bg: #fff8dc;      --adv-bd: #e5b800;      --adv-fg: #6b5400;
+    --watch-bg: #fff0e0;    --watch-bd: #f08a24;    --watch-fg: #7a3d00;
+    --warn-bg: #fdeaea;     --warn-bd: #d32f2f;     --warn-fg: #8a1414;
+}
+
+.sr-only {
+    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
+    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
+}
+[hidden] { display: none !important; }
+.muted { color: var(--muted); }
+.small { font-size: 0.82rem; }
+.pad { padding: 16px; }
+
+.dash { display: flex; flex-direction: column; gap: 18px; }
+.dash h1, .dash h2 { margin: 0; }
+.dash-title { font-size: clamp(1.6rem, 3.5vw, 2.3rem); color: var(--green-dark); line-height: 1.15; }
+.dash h2 { font-size: 1rem; color: var(--green-dark); }
+.dash .eyebrow { margin: 0 0 4px; }
+
+/* header + location chip */
+.dash-head { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: flex-end; justify-content: space-between; }
+.loc-chip {
+    display: flex; align-items: center; gap: 10px;
+    background: var(--card); border: 1px solid var(--line); border-radius: 999px;
+    padding: 8px 8px 8px 14px; max-width: 100%;
+}
+.loc-text { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
+.loc-text strong { font-size: 0.95rem; overflow-wrap: anywhere; }
+.loc-text small { color: var(--muted); font-size: 0.75rem; }
+
+.link-btn {
+    background: none; border: 0; padding: 6px 10px; border-radius: 6px; cursor: pointer;
+    color: var(--green); font: inherit; font-size: 0.88rem; font-weight: bold;
+}
+.link-btn:hover { background: #eaf3ec; }
+.link-btn:disabled { opacity: 0.5; cursor: default; }
+.link-btn:focus-visible, .button:focus-visible, select:focus-visible, summary:focus-visible {
+    outline: 3px solid #8fd0a8; outline-offset: 2px;
+}
+
+button.button { border: 0; font: inherit; cursor: pointer; margin-top: 0; }
+button.button:disabled { opacity: 0.5; cursor: default; }
+.button-ghost { background: #eaf3ec; color: var(--green-dark); }
+.button-ghost:hover { background: #d9ebdf; }
+
+/* cards */
+.card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; }
+.card-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; }
+.card-head .link-btn { margin: -6px -8px -6px 0; }
+
+/* location setup */
+.loc-setup h2 { font-size: 1.25rem; margin-bottom: 4px; }
+.loc-setup p { margin: 4px 0 14px; max-width: 60ch; }
+.loc-actions { display: flex; flex-wrap: wrap; gap: 12px 14px; align-items: center; }
+.or { color: var(--muted); font-size: 0.9rem; }
+.picker { display: flex; flex-wrap: wrap; gap: 8px; }
+select {
+    font: inherit; padding: 10px 12px; border: 1px solid #c9d4c8; border-radius: 6px;
+    background: #fff; color: var(--ink); min-width: 150px;
+}
+select:disabled { background: #f0f3ee; color: #9aa59c; }
+.loc-msg { margin: 12px 0 0 !important; min-height: 1.4em; color: var(--muted); }
+.loc-msg.error { color: var(--warn-fg); }
+
+/* alerts */
+.alerts { display: flex; flex-direction: column; gap: 10px; }
+.alert { border: 1px solid; border-left-width: 6px; border-radius: 10px; padding: 12px 16px; }
+.alert p { margin: 0; }
+.alert-title { font-weight: bold; }
+.alert-level {
+    display: inline-block; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.08em;
+    padding: 2px 7px; border-radius: 4px; background: rgba(0,0,0,0.1); vertical-align: 1px; margin-right: 2px;
+}
+.alert-detail { margin-top: 4px !important; font-size: 0.93rem; }
+.prep { margin-top: 8px; font-size: 0.93rem; }
+.prep summary { cursor: pointer; font-weight: bold; padding: 2px 0; }
+.prep ul { margin: 6px 0 2px; padding-left: 20px; }
+.prep li { margin: 3px 0; }
+.level-ok       { background: var(--ok-bg);    border-color: var(--ok-bd);    color: var(--ok-fg); }
+.level-info     { background: #eef3fb;         border-color: #7aa0d6;         color: #1f3f6e; }
+.level-advisory { background: var(--adv-bg);   border-color: var(--adv-bd);   color: var(--adv-fg); }
+.level-watch    { background: var(--watch-bg); border-color: var(--watch-bd); color: var(--watch-fg); }
+.level-warning  { background: var(--warn-bg);  border-color: var(--warn-bd);  color: var(--warn-fg); }
+.level-error    { background: var(--warn-bg);  border-color: var(--warn-bd);  color: var(--warn-fg); }
+
+/* status row */
+.status-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin-bottom: 12px; }
+.status-row .warn { color: var(--watch-fg); font-weight: bold; }
+
+/* grid */
+.grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }
+.now { grid-column: span 7; }
+.minimap { grid-column: span 5; }
+.risk { grid-column: span 5; }
+.hourly { grid-column: span 7; }
+.week { grid-column: span 12; }
+.grid > .card { min-width: 0; }
+
+/* current conditions */
+.now-main { display: flex; align-items: center; gap: 18px; margin-bottom: 16px; }
+.now-icon { font-size: 4rem; line-height: 1; }
+.now-temp { font-size: 3.6rem; font-weight: bold; line-height: 1; color: var(--green-dark); }
+.now-temp sup { font-size: 1.4rem; vertical-align: top; position: relative; top: 4px; margin-left: 2px; }
+.now-desc { font-size: 1.1rem; font-weight: bold; }
+/* On wide screens this card is stretched to the height of the map card beside it.
+   Scale the top section up and let it take the spare space, so the four stat
+   cards sit flush with the bottom of the card. */
+.now { display: flex; flex-direction: column; }
+.now-main { flex: 1; }
+@media (min-width: 901px) {
+    .now-main { gap: 28px; }
+    .now-icon { font-size: 7rem; }
+    .now-temp { font-size: 5.6rem; }
+    .now-temp sup { font-size: 2.2rem; top: 8px; margin-left: 4px; }
+    .now-desc { font-size: 1.7rem; margin-top: 4px; }
+    .now-main .small { font-size: 1.05rem; }
+}
+.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 0; }
+.stat { background: #f5f7f2; border-radius: 10px; padding: 10px 12px; min-width: 0; }
+.stat dt { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
+.stat dd { margin: 2px 0; font-size: 1.35rem; font-weight: bold; color: var(--green-dark); }
+.meter { height: 6px; background: #dbe4d9; border-radius: 3px; overflow: hidden; }
+.meter i { display: block; height: 100%; width: 0; background: #3b8fb8; border-radius: 3px; transition: width 0.4s; }
+
+/* minimap */
+.map-wrap { display: block; }
+#map { height: 250px; border-radius: 10px; border: 1px solid var(--line); background: #e8efe6; z-index: 0; }
+.map-hint { margin: 8px 0 0; }
+
+/* risk */
+.risk-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 10px 0 14px; }
+.risk-item { display: flex; flex-direction: column; background: #f5f7f2; border-radius: 10px; padding: 10px; }
+.risk-item .big { font-size: 1.7rem; font-weight: bold; color: var(--green-dark); line-height: 1.1; }
+.outlook { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
+.pill-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.pill-label { width: 44px; font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
+.pill { border: 1px solid; border-radius: 999px; padding: 3px 12px; font-size: 0.88rem; font-weight: bold; }
+
+/* hourly chart */
+.hourly-chart { width: 100%; }
+.chart { width: 100%; height: auto; display: block; }
+.chart .gridline { stroke: #e2e8df; stroke-width: 1; }
+.chart .axis { fill: var(--muted); font-size: 9px; font-family: inherit; }
+.chart .bar { fill: #3b8fb8; }
+.chart .bar:hover { fill: #26698c; }
+.chart .bar-hot { fill: #d8541f; }
+
+/* 7-day */
+.days { list-style: none; margin: 10px 0 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
+.day { display: flex; flex-direction: column; align-items: center; gap: 2px; text-align: center; background: #f5f7f2; border-radius: 10px; padding: 12px 6px; }
+.day-name { font-weight: bold; font-size: 0.88rem; }
+.day-icon { font-size: 1.8rem; line-height: 1.3; }
+.day-temp { font-size: 0.9rem; }
+.day-rain { font-size: 0.78rem; color: #2a6f93; }
+.day-rain.heavy { color: var(--warn-fg); font-weight: bold; }
+
+.fineprint { margin: 18px 0 0; max-width: 80ch; }
+
+/* tablet / phone */
+@media (max-width: 900px) {
+    .now, .minimap, .risk, .hourly, .week { grid-column: span 12; }
+    .days { grid-template-columns: repeat(auto-fit, minmax(92px, 1fr)); }
+}
+@media (max-width: 560px) {
+    .stats { grid-template-columns: repeat(2, 1fr); }
+    .now-icon { font-size: 3rem; }
+    .now-temp { font-size: 3rem; }
+    .loc-actions, .picker { width: 100%; }
+    .picker select, .picker .button, .loc-actions > .button { flex: 1 1 100%; }
+    .site-header { padding: 16px 5%; }
+}
+@media (prefers-reduced-motion: reduce) { .meter i { transition: none; } }
+
+/* phone: 7-day forecast as compact rows, larger chart labels */
+@media (max-width: 560px) {
+    .days { grid-template-columns: 1fr; gap: 6px; }
+    .day { flex-direction: row; justify-content: space-between; gap: 10px; padding: 8px 12px; }
+    .day-name { width: 52px; text-align: left; }
+    .day-icon { font-size: 1.4rem; }
+    .day-rain { margin-left: auto; text-align: right; }
+    .chart .axis { font-size: 14px; }
+}
diff --git a/NetAgri/pages/static/pages/dashboard.js b/NetAgri/pages/static/pages/dashboard.js
new file mode 100644
index 0000000..ed04e26
--- /dev/null
+++ b/NetAgri/pages/static/pages/dashboard.js
@@ -0,0 +1,450 @@
+/*
+ * NetAgri dashboard: location detection, weather widgets, minimap, alerts.
+ * Depends on climate.js (NetAgriClimate) and, optionally, Leaflet (window.L).
+ */
+(function () {
+  "use strict";
+  const C = window.NetAgriClimate;
+  const $ = (id) => document.getElementById(id);
+
+  const NER = JSON.parse($("ner-data").textContent);
+  const LS = { loc: "netagri.location", map: "netagri.mapOpen", notified: "netagri.notified", cache: "netagri.cache." };
+  const REFRESH_MS = 30 * 60 * 1000;
+  const NEAR_KM = 60; // within this of a known town -> "Near <town>"
+
+  /* ------------------------- tiny safe storage helpers ------------------------- */
+  const store = {
+    get(k) { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } },
+    set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { /* private mode / full */ } },
+    del(k) { try { localStorage.removeItem(k); } catch (e) { /* ignore */ } },
+  };
+
+  /* safe DOM builder (no innerHTML with data) */
+  function el(tag, props, kids) {
+    const n = document.createElement(tag);
+    for (const [k, v] of Object.entries(props || {})) {
+      if (k === "class") n.className = v;
+      else if (k === "text") n.textContent = v;
+      else n.setAttribute(k, v);
+    }
+    for (const kid of [].concat(kids || [])) if (kid != null) n.append(kid);
+    return n;
+  }
+  const num = (v, d = 0) => (v == null || Number.isNaN(v) ? "--" : Number(v).toFixed(d));
+
+  /* ================================================================== *
+   *  LOCATION
+   * ================================================================== */
+  let loc = null;       // {lat, lon, label, source, accuracy?}
+  let lastData = null;  // {forecast, flood, fetchedAt, offline}
+  let refreshTimer = null;
+
+  function labelFor(lat, lon) {
+    const near = C.nearestPlace(lat, lon, NER.states);
+    const inside = C.inBounds(lat, lon, NER.bounds);
+    if (near && near.km <= NEAR_KM) {
+      return { label: `Near ${near.name}, ${near.state}`, inside, nearKm: near.km };
+    }
+    const coords = `${lat.toFixed(3)}°N, ${lon.toFixed(3)}°E`;
+    return { label: inside ? `${coords} (NER)` : coords, inside, nearKm: near ? near.km : null };
+  }
+
+  function setMsg(text, isError) {
+    const m = $("loc-msg");
+    m.textContent = text || "";
+    m.classList.toggle("error", !!isError);
+  }
+
+  function showSetup(show) { $("loc-setup").hidden = !show; }
+
+  function saveLoc() { store.set(LS.loc, loc); }
+
+  function applyLocation(newLoc, opts) {
+    opts = opts || {};
+    loc = newLoc;
+    saveLoc();
+    $("dash").dataset.state = "ready";
+    showSetup(false);
+    setMsg("");
+
+    $("loc-label").textContent = loc.label;
+    const meta = [];
+    if (loc.source === "gps") meta.push(loc.accuracy ? `GPS ±${formatAcc(loc.accuracy)}` : "GPS");
+    else if (loc.source === "map") meta.push("set on map");
+    else meta.push("chosen manually");
+    if (loc.outside) meta.push("outside NER");
+    $("loc-meta").textContent = meta.join(" · ");
+    $("loc-chip").hidden = false;
+    $("dash-body").hidden = false;
+    showNotice(loc.outside
+      ? "This location is outside the North Eastern Region. NetAgri is built for NER, but the weather and alerts still work here."
+      : "");
+
+    initMap();
+    updateMap(opts.fromMap);
+    loadWeather();
+  }
+
+  function formatAcc(m) { return m >= 1000 ? `${(m / 1000).toFixed(1)} km` : `${Math.round(m)} m`; }
+
+  /* ---------- GPS ---------- */
+  function detectGPS(silent) {
+    if (!("geolocation" in navigator)) {
+      setMsg("This browser can't detect location. Please choose your town below.", true);
+      return;
+    }
+    if (window.isSecureContext === false) {
+      setMsg("Location detection needs a secure (https) connection. Please choose your town below.", true);
+      return;
+    }
+    const btn = $("btn-gps");
+    btn.disabled = true;
+    if (!silent) setMsg("Finding your location…");
+
+    navigator.geolocation.getCurrentPosition(
+      (pos) => {
+        btn.disabled = false;
+        const { latitude: lat, longitude: lon, accuracy } = pos.coords;
+        const info = labelFor(lat, lon);
+        applyLocation({ lat, lon, accuracy, source: "gps", label: info.label, outside: !info.inside });
+      },
+      (err) => {
+        btn.disabled = false;
+        const reasons = {
+          1: "Location access was blocked. You can allow it in your browser's site settings, or choose your town below.",
+          2: "Your device couldn't work out where you are (no GPS or network signal). Please choose your town below.",
+          3: "Finding your location took too long. Try again, or choose your town below.",
+        };
+        showSetup(true);
+        setMsg(reasons[err.code] || "Couldn't detect your location. Please choose your town below.", true);
+      },
+      { enableHighAccuracy: false, timeout: 12000, maximumAge: 10 * 60 * 1000 }
+    );
+  }
+
+  function showNotice(text) {
+    const box = $("notices");
+    box.replaceChildren();
+    if (text) box.append(el("div", { class: "alert level-info" }, [el("p", { text })]));
+  }
+
+  /* ---------- manual picker ---------- */
+  function initPicker() {
+    const sState = $("sel-state"), sPlace = $("sel-place"), go = $("btn-pick");
+    NER.states.forEach((s, i) => sState.append(el("option", { value: i, text: s.name })));
+
+    sState.addEventListener("change", () => {
+      sPlace.replaceChildren(el("option", { value: "", text: "District…" }));
+      go.disabled = true;
+      if (sState.value === "") { sPlace.disabled = true; return; }
+      NER.states[+sState.value].places.forEach((p, i) => sPlace.append(el("option", { value: i, text: p.name })));
+      sPlace.disabled = false;
+      sPlace.value = "0"; // capital by default
+      go.disabled = false;
+    });
+    sPlace.addEventListener("change", () => { go.disabled = sPlace.value === ""; });
+
+    go.addEventListener("click", () => {
+      const s = NER.states[+sState.value], p = s && s.places[+sPlace.value];
+      if (!p) return;
+      applyLocation({ lat: p.lat, lon: p.lon, source: "manual", label: `${p.name}, ${s.name}` });
+    });
+  }
+
+  /* ================================================================== *
+   *  WEATHER
+   * ================================================================== */
+  function cacheKey(l) { return LS.cache + l.lat.toFixed(2) + "," + l.lon.toFixed(2); }
+
+  async function loadWeather() {
+    clearTimeout(refreshTimer);
+    $("btn-refresh").disabled = true;
+    const here = loc;
+    try {
+      const { forecast, flood } = await C.fetchWeather(here.lat, here.lon);
+      if (loc !== here) return; // user moved on while we were fetching
+      lastData = { forecast, flood, fetchedAt: Date.now(), offline: false };
+      store.set(cacheKey(here), { t: lastData.fetchedAt, forecast, flood });
+      render();
+    } catch (e) {
+      if (loc !== here) return;
+      const cached = store.get(cacheKey(here));
+      if (cached && Date.now() - cached.t < 24 * 3600 * 1000) {
+        lastData = { forecast: cached.forecast, flood: cached.flood, fetchedAt: cached.t, offline: true };
+        render();
+      } else {
+        showError();
+      }
+    } finally {
+      $("btn-refresh").disabled = false;
+      refreshTimer = setTimeout(loadWeather, REFRESH_MS);
+    }
+  }
+
+  function showError() {
+    $("alerts").replaceChildren(el("div", { class: "alert level-error", role: "alert" }, [
+      el("p", { class: "alert-title", text: "Couldn't load the forecast" }),
+      el("p", { text: "Check your internet connection and press Refresh. If you've loaded this place before, a saved copy will be shown when you're offline." }),
+    ]));
+    $("updated").textContent = "";
+  }
+
+  /* ---------- render everything from lastData ---------- */
+  function render() {
+    const { forecast: f, flood, fetchedAt, offline } = lastData;
+    const cur = f.current, day = f.daily;
+    const w = C.describe(cur.weather_code);
+    const result = C.evaluate(f, flood);
+
+    // current
+    $("now-icon").textContent = w.icon;
+    $("now-temp").textContent = num(cur.temperature_2m);
+    $("now-desc").textContent = w.label;
+    $("now-feels").textContent = num(cur.apparent_temperature);
+    $("st-temp").textContent = num(cur.temperature_2m, 1);
+    $("st-lo").textContent = num(day.temperature_2m_min[0]);
+    $("st-hi").textContent = num(day.temperature_2m_max[0]);
+    $("st-hum").textContent = num(cur.relative_humidity_2m);
+    $("st-hum-bar").style.width = Math.max(0, Math.min(100, cur.relative_humidity_2m || 0)) + "%";
+    $("st-rain").textContent = num(cur.precipitation, 1);
+    $("st-wind").textContent = num(cur.wind_speed_10m);
+    $("st-gust").textContent = num(cur.wind_gusts_10m);
+
+    // risk card
+    const s = result.summary;
+    $("r-24").textContent = num(s.rain24, 0);
+    $("r-72").textContent = num(s.rain72, 0);
+    $("r-prob").textContent = num(s.probMax48, 0);
+    renderOutlook(result);
+    $("river-line").textContent = result.river
+      ? `River flow nearby: ${result.river.todayQ} m³/s today, peaking at ${result.river.peakQ} m³/s on ${result.river.peakDate}.`
+      : "No river-flow data for this spot (small streams aren't covered).";
+
+    renderHourly(f, s);
+    renderDays(day);
+    renderAlerts(result);
+    maybeNotify(result);
+
+    const when = new Date(fetchedAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
+    $("updated").textContent = offline
+      ? `⚠ Offline - showing saved forecast from ${when}`
+      : `Updated ${when}`;
+    $("updated").classList.toggle("warn", offline);
+  }
+
+  function renderOutlook(result) {
+    const rain = result.alerts.find((a) => a.kind === "rain");
+    const flood = result.alerts.find((a) => a.kind === "flood");
+    const pill = (label, alert, none) =>
+      el("div", { class: "pill-row" }, [
+        el("span", { class: "pill-label", text: label }),
+        el("span", { class: "pill level-" + (alert ? alert.level : "ok"), text: alert ? alert.title : none }),
+      ]);
+    $("outlook").replaceChildren(
+      pill("Rain", rain, "No significant rain expected"),
+      pill("Flood", flood, "Low risk")
+    );
+  }
+
+  /* ---------- 48 h rainfall bars (inline SVG) ---------- */
+  function renderHourly(f, s) {
+    const h = f.hourly, i = s.startIndex, N = 48;
+    const vals = h.precipitation.slice(i, i + N).map((v) => v || 0);
+    const times = h.time.slice(i, i + N);
+    const probs = (h.precipitation_probability || []).slice(i, i + N);
+    const yMax = Math.max(5, Math.ceil(Math.max(...vals) / 5) * 5);
+    const W = 480, H = 130, padL = 26, padB = 20, padT = 6;
+    const bw = (W - padL) / N, ph = H - padB - padT;
+    const NS = "http://www.w3.org/2000/svg";
+    const svgEl = (tag, attrs) => { const n = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(attrs || {})) n.setAttribute(k, v); return n; };
+
+    const svg = svgEl("svg", { viewBox: `0 0 ${W} ${H}`, role: "img", class: "chart",
+      "aria-label": `Hourly rainfall for the next 48 hours. Total ${s.rain48} millimetres, peak ${s.peakHourMm} millimetres in one hour.` });
+
+    [0, yMax / 2, yMax].forEach((g) => {
+      const y = padT + ph - (g / yMax) * ph;
+      svg.append(svgEl("line", { x1: padL, x2: W, y1: y, y2: y, class: "gridline" }));
+      const t = svgEl("text", { x: padL - 4, y: y + 3, class: "axis", "text-anchor": "end" });
+      t.textContent = g % 1 ? g.toFixed(1) : g;
+      svg.append(t);
+    });
+    vals.forEach((v, k) => {
+      const bh = (v / yMax) * ph;
+      const r = svgEl("rect", { x: padL + k * bw + 0.6, width: Math.max(bw - 1.2, 1), y: padT + ph - bh, height: Math.max(bh, v > 0 ? 1 : 0), class: "bar" + (v >= C.T.intenseHour ? " bar-hot" : "") , rx: 1 });
+      const tip = svgEl("title");
+      tip.textContent = `${times[k].slice(5, 10)} ${times[k].slice(11, 16)}  ·  ${v.toFixed(1)} mm` + (probs[k] != null ? `  ·  ${probs[k]}% chance` : "");
+      r.append(tip);
+      svg.append(r);
+    });
+    times.forEach((t, k) => {
+      const hr = +t.slice(11, 13);
+      if (k === 0 || hr % 6 === 0) {
+        const tx = svgEl("text", { x: padL + k * bw + bw / 2, y: H - 5, class: "axis", "text-anchor": k === 0 ? "start" : "middle" });
+        tx.textContent = k === 0 ? "now" : hr === 0 ? t.slice(8, 10) + "/" + t.slice(5, 7) : String(hr).padStart(2, "0") + "h";
+        svg.append(tx);
+      }
+    });
+    $("hourly-chart").replaceChildren(svg);
+    $("hourly-peak").textContent = s.peakHourMm > 0 ? `Peak ${s.peakHourMm} mm/h around ${s.peakHourTime.slice(11, 16)}` : "No rain expected";
+  }
+
+  /* ---------- 7 day ---------- */
+  function renderDays(d) {
+    const rows = d.time.map((t, k) => {
+      const dt = new Date(t + "T00:00:00");
+      const name = k === 0 ? "Today" : dt.toLocaleDateString([], { weekday: "short" });
+      const w = C.describe(d.weather_code[k]);
+      const prob = d.precipitation_probability_max ? d.precipitation_probability_max[k] : null;
+      return el("li", { class: "day" }, [
+        el("span", { class: "day-name", text: name }),
+        el("span", { class: "day-icon", title: w.label, text: w.icon, "aria-label": w.label }),
+        el("span", { class: "day-temp" }, [el("strong", { text: num(d.temperature_2m_max[k]) + "°" }), " ", el("span", { class: "muted", text: num(d.temperature_2m_min[k]) + "°" })]),
+        el("span", { class: "day-rain" + ((d.precipitation_sum[k] || 0) >= C.T.heavy24 ? " heavy" : ""), text: `${num(d.precipitation_sum[k], 1)} mm` + (prob != null ? ` · ${prob}%` : "") }),
+      ]);
+    });
+    $("days").replaceChildren(...rows);
+  }
+
+  /* ---------- alerts ---------- */
+  const LEVEL_NAME = { advisory: "Advisory", watch: "Watch", warning: "Warning" };
+
+  function renderAlerts(result) {
+    const box = $("alerts");
+    box.replaceChildren();
+    if (!result.alerts.length) {
+      box.append(el("div", { class: "alert level-ok", role: "status" }, [
+        el("p", { class: "alert-title", text: "No rain or flood alerts for the next 72 hours" }),
+      ]));
+      return;
+    }
+    result.alerts.forEach((a, idx) => {
+      const details = el("details", { class: "prep" }, [
+        el("summary", { text: "What to prepare" }),
+        el("ul", {}, a.actions.map((t) => el("li", { text: t }))),
+      ]);
+      if (a.level === "warning" || idx === 0) details.open = true;
+      box.append(el("div", { class: "alert level-" + a.level, role: a.level === "warning" ? "alert" : "status" }, [
+        el("p", { class: "alert-title" }, [
+          el("span", { class: "alert-level", text: LEVEL_NAME[a.level] }),
+          " " + a.title,
+        ]),
+        el("p", { class: "alert-detail", text: a.detail }),
+        details,
+      ]));
+    });
+  }
+
+  /* ---------- browser notifications (only fire while the page is open) ---------- */
+  function notifySupported() { return "Notification" in window; }
+
+  function initNotifyButton() {
+    const b = $("btn-notify");
+    if (!notifySupported() || Notification.permission !== "default") return;
+    b.hidden = false;
+    b.addEventListener("click", async () => {
+      const p = await Notification.requestPermission();
+      b.hidden = true;
+      if (p === "granted" && lastData) maybeNotify(C.evaluate(lastData.forecast, lastData.flood));
+    });
+  }
+
+  function maybeNotify(result) {
+    if (!notifySupported() || Notification.permission !== "granted") return;
+    const today = new Date().toISOString().slice(0, 10);
+    const seen = store.get(LS.notified) || {};
+    for (const k of Object.keys(seen)) if (!k.endsWith(today)) delete seen[k]; // drop old days
+    for (const a of result.alerts) {
+      if (a.level === "advisory") continue; // only interrupt people for watch/warning
+      const key = `${loc.label}|${a.id}|${today}`;
+      if (seen[key]) continue;
+      seen[key] = 1;
+      try { new Notification(`NetAgri · ${LEVEL_NAME[a.level]}: ${a.title}`, { body: `${loc.label}. ${a.detail}`, tag: key }); } catch (e) { /* some mobile browsers need a service worker */ }
+    }
+    store.set(LS.notified, seen);
+  }
+
+  /* ================================================================== *
+   *  MINIMAP
+   * ================================================================== */
+  let map = null, marker = null, accCircle = null;
+
+  function initMap() {
+    if (map) return;
+    const box = $("map");
+    if (!window.L) {
+      box.replaceChildren(el("p", { class: "muted small pad", text: "The map couldn't load (it needs an internet connection). The weather below still works." }));
+      return;
+    }
+    map = L.map(box, { zoomControl: true, scrollWheelZoom: false, attributionControl: true }).setView([loc.lat, loc.lon], 9);
+    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
+      maxZoom: 18,
+      // OSM blocks tile requests that arrive without a Referer header (HTTP 403).
+      referrerPolicy: "strict-origin-when-cross-origin",
+      attribution: "&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors",
+    }).addTo(map);
+    marker = L.marker([loc.lat, loc.lon], { draggable: true, title: "Your location" }).addTo(map);
+    marker.on("dragend", () => {
+      const p = marker.getLatLng();
+      const info = labelFor(p.lat, p.lng);
+      applyLocation({ lat: p.lat, lon: p.lng, source: "map", label: info.label, outside: !info.inside }, { fromMap: true });
+    });
+  }
+
+  function updateMap(fromMap) {
+    if (!map) return;
+    marker.setLatLng([loc.lat, loc.lon]);
+    if (accCircle) { accCircle.remove(); accCircle = null; }
+    if (loc.source === "gps" && loc.accuracy && loc.accuracy < 20000) {
+      accCircle = L.circle([loc.lat, loc.lon], { radius: loc.accuracy, weight: 1, color: "#267447", fillOpacity: 0.1 }).addTo(map);
+    }
+    if (!fromMap) map.setView([loc.lat, loc.lon], 9);
+    setTimeout(() => map.invalidateSize(), 50);
+  }
+
+  function setMapOpen(open, persist) {
+    $("map-wrap").hidden = !open;
+    const t = $("map-toggle");
+    t.setAttribute("aria-expanded", String(open));
+    t.textContent = open ? "Hide map ▴" : "Show map ▾";
+    if (persist) store.set(LS.map, open);
+    if (open && map) setTimeout(() => map.invalidateSize(), 50);
+  }
+
+  function initMapToggle() {
+    const saved = store.get(LS.map);
+    const open = saved == null ? window.matchMedia("(min-width: 760px)").matches : !!saved;
+    setMapOpen(open, false);
+    $("map-toggle").addEventListener("click", () => setMapOpen($("map-wrap").hidden, true));
+  }
+
+  /* ================================================================== *
+   *  BOOT
+   * ================================================================== */
+  function boot() {
+    initPicker();
+    initMapToggle();
+    initNotifyButton();
+
+    $("btn-gps").addEventListener("click", () => detectGPS(false));
+    $("btn-refresh").addEventListener("click", loadWeather);
+    $("loc-change").addEventListener("click", () => { showSetup(true); $("loc-setup").scrollIntoView({ behavior: "smooth", block: "nearest" }); });
+    document.addEventListener("visibilitychange", () => {
+      if (!document.hidden && loc && lastData && Date.now() - lastData.fetchedAt > REFRESH_MS) loadWeather();
+    });
+
+    const saved = store.get(LS.loc);
+    if (saved && Number.isFinite(saved.lat) && Number.isFinite(saved.lon)) {
+      applyLocation(saved);
+      return;
+    }
+    showSetup(true);
+    // If the user already allowed location for this site, don't make them click.
+    if (navigator.permissions && navigator.permissions.query) {
+      navigator.permissions.query({ name: "geolocation" }).then((p) => {
+        if (p.state === "granted") detectGPS(true);
+      }).catch(() => {});
+    }
+  }
+
+  boot();
+})();

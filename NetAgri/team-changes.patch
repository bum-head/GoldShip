+// Climate module: weather data + Good→Bad rating.   Routes: /api/climate/...
+const { parseCoords, fetchRawWeather, normalizeWeather, DEFAULT_LAT, DEFAULT_LON } = require("./service");
+const { rateWeather } = require("./rating");
+
+module.exports = {
+  name: "climate",
+  description: "Current weather (Open-Meteo) and a Good→Bad farming rating",
+  version: "1.0.0",
+
+  routes: [
+    {
+      method: "GET",
+      path: "/weather",
+      description: "Raw Open-Meteo JSON. Optional ?lat=&lon=",
+      handler: async ({ query }) => fetchRawWeather(parseCoords(query)),
+    },
+    {
+      method: "GET",
+      path: "/rating",
+      description: "Readings + rating. Optional ?lat=&lon=",
+      handler: async ({ query }) => {
+        const location = parseCoords(query);
+        const weather = normalizeWeather(await fetchRawWeather(location));
+        return { location, weather, rating: rateWeather(weather) };
+      },
+    },
+  ],
+
+  // Used by the dashboard: can we reach the weather API right now?
+  health: async () => {
+    const w = normalizeWeather(await fetchRawWeather({ lat: DEFAULT_LAT, lon: DEFAULT_LON }));
+    return { ok: true, detail: `Weather API reachable (${w.temperature} °C at default location)` };
+  },
+};
diff --git a/backend/modules/climate/rating.js b/backend/modules/climate/rating.js
new file mode 100644
index 0000000..2867044
--- /dev/null
+++ b/backend/modules/climate/rating.js
@@ -0,0 +1,66 @@
+// Turns weather readings into a Good → Bad rating for outdoor/farm work.
+// Pure function (no network), easy to tune.  Score starts at 100 and loses points:
+//   80-100 Good | 60-79 Fair | 40-59 Poor | 0-39 Bad
+
+const clamp = (n, lo, hi) => Math.min(hi, Math.max(lo, n));
+
+// WMO weather codes -> [penalty, description]
+const CONDITIONS = {
+  0: [0, "Clear sky"], 1: [0, "Mainly clear"], 2: [0, "Partly cloudy"], 3: [3, "Overcast"],
+  45: [10, "Fog"], 48: [10, "Freezing fog"],
+  51: [10, "Light drizzle"], 53: [10, "Drizzle"], 55: [12, "Heavy drizzle"],
+  56: [15, "Freezing drizzle"], 57: [18, "Heavy freezing drizzle"],
+  61: [15, "Light rain"], 63: [20, "Rain"], 65: [30, "Heavy rain"],
+  66: [25, "Freezing rain"], 67: [30, "Heavy freezing rain"],
+  71: [20, "Light snow"], 73: [25, "Snow"], 75: [30, "Heavy snow"], 77: [20, "Snow grains"],
+  80: [12, "Light rain showers"], 81: [18, "Rain showers"], 82: [30, "Violent rain showers"],
+  85: [25, "Snow showers"], 86: [30, "Heavy snow showers"],
+  95: [35, "Thunderstorm"], 96: [45, "Thunderstorm with hail"], 99: [45, "Severe thunderstorm with hail"],
+};
+
+const LEVELS = [
+  { min: 80, label: "Good", level: "good" },
+  { min: 60, label: "Fair", level: "fair" },
+  { min: 40, label: "Poor", level: "poor" },
+  { min: 0,  label: "Bad",  level: "bad" },
+];
+
+function rateWeather(w) {
+  const factors = [];
+  const add = (name, penalty, note) => factors.push({ name, penalty: Math.round(penalty), note });
+
+  const t = w.temperature; // comfortable: 15-30 °C
+  if (typeof t === "number") {
+    if (t < 15) add("Temperature", clamp((15 - t) * 3, 0, 40), `${t} °C is cold`);
+    else if (t > 30) add("Temperature", clamp((t - 30) * 4, 0, 40), `${t} °C is hot`);
+    else add("Temperature", 0, `${t} °C is comfortable`);
+  }
+
+  const wind = w.windspeed; // fine up to 15 km/h
+  if (typeof wind === "number") {
+    if (wind > 15) add("Wind", clamp((wind - 15) * 1.5, 0, 30), `${wind} km/h is strong`);
+    else add("Wind", 0, `${wind} km/h is calm`);
+  }
+
+  const rain = w.precipitation;
+  if (typeof rain === "number") {
+    if (rain > 0) add("Precipitation", clamp(rain * 10, 0, 30), `${rain} mm falling`);
+    else add("Precipitation", 0, "No precipitation");
+  }
+
+  const h = w.humidity; // fine at 30-85 %
+  if (typeof h === "number") {
+    if (h > 85) add("Humidity", clamp(h - 85, 0, 15), `${h}% is very humid`);
+    else if (h < 30) add("Humidity", clamp((30 - h) * 0.5, 0, 10), `${h}% is very dry`);
+    else add("Humidity", 0, `${h}% is comfortable`);
+  }
+
+  const [codePenalty, condition] = CONDITIONS[w.weathercode] || [0, "Unknown conditions"];
+  add("Conditions", codePenalty, condition);
+
+  const score = clamp(Math.round(100 - factors.reduce((s, f) => s + f.penalty, 0)), 0, 100);
+  const { label, level } = LEVELS.find((l) => score >= l.min);
+  return { score, label, level, condition, factors };
+}
+
+module.exports = { rateWeather };
diff --git a/backend/modules/climate/service.js b/backend/modules/climate/service.js
new file mode 100644
index 0000000..b5ea751
--- /dev/null
+++ b/backend/modules/climate/service.js
@@ -0,0 +1,52 @@
+const { HttpError } = require("../../core/errors");
+
+const API_URL = process.env.WEATHER_API_URL || "https://api.open-meteo.com/v1/forecast";
+const TIMEOUT_MS = 8000;
+const DEFAULT_LAT = 26.73; // Assam
+const DEFAULT_LON = 93.15;
+
+// Reads and validates lat/lon from the query (falls back to the defaults).
+function parseCoords(query) {
+  const read = (raw, fallback) => (raw === undefined || String(raw).trim() === "" ? fallback : Number(raw));
+  const lat = read(query.lat, DEFAULT_LAT);
+  const lon = read(query.lon, DEFAULT_LON);
+  if (!Number.isFinite(lat) || lat < -90 || lat > 90) throw new HttpError(400, "lat must be a number between -90 and 90");
+  if (!Number.isFinite(lon) || lon < -180 || lon > 180) throw new HttpError(400, "lon must be a number between -180 and 180");
+  return { lat, lon };
+}
+
+// Raw Open-Meteo JSON (current_weather block + humidity/precipitation).
+async function fetchRawWeather({ lat, lon }) {
+  const url = new URL(API_URL);
+  url.searchParams.set("latitude", lat);
+  url.searchParams.set("longitude", lon);
+  url.searchParams.set("current_weather", "true");
+  url.searchParams.set("current", "relative_humidity_2m,precipitation");
+  url.searchParams.set("timezone", "auto");
+
+  let res;
+  try {
+    res = await fetch(url, { signal: AbortSignal.timeout(TIMEOUT_MS) });
+  } catch (e) {
+    throw new HttpError(502, `Weather service unreachable: ${e.message}`);
+  }
+  if (!res.ok) throw new HttpError(502, `Weather service returned ${res.status}`);
+  return res.json();
+}
+
+// Flattens the raw response into the fields the rating uses.
+function normalizeWeather(raw) {
+  const cw = raw.current_weather;
+  if (!cw) throw new HttpError(502, "Weather service returned no current weather");
+  const cur = raw.current || {};
+  return {
+    temperature: cw.temperature,                 // °C
+    windspeed: cw.windspeed,                     // km/h
+    weathercode: cw.weathercode,                 // WMO code
+    humidity: cur.relative_humidity_2m ?? null,  // %
+    precipitation: cur.precipitation ?? 0,       // mm
+    time: cw.time,
+  };
+}
+
+module.exports = { parseCoords, fetchRawWeather, normalizeWeather, DEFAULT_LAT, DEFAULT_LON };

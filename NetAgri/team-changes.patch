+* { box-sizing: border-box; }
+body { margin: 0; padding: 24px; font-family: Arial, sans-serif; background: #f5f7f2; color: #25352a; line-height: 1.5; max-width: 960px; margin-inline: auto; }
+header { display: flex; align-items: center; gap: 14px; }
+h1 { margin: 0; color: #204e34; }
+h2 { margin: 28px 0 10px; font-size: 1.1rem; color: #204e34; }
+
+.pill { padding: 3px 12px; border-radius: 999px; font-size: 0.8rem; font-weight: bold; color: #fff; background: #627066; }
+.pill[data-s="ok"] { background: #267447; }
+.pill[data-s="degraded"], .pill[data-s="down"] { background: #e08a1e; }
+.pill[data-s="failed"], .pill[data-s="unreachable"] { background: #c0392b; }
+
+.system { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0; }
+.stat { background: #fff; border: 1px solid #e2e8df; border-radius: 8px; padding: 8px 14px; min-width: 120px; }
+.stat small { display: block; color: #627066; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; }
+
+.toolbar { display: flex; align-items: center; gap: 16px; font-size: 0.9rem; }
+button { padding: 6px 12px; border: 0; border-radius: 4px; background: #267447; color: #fff; cursor: pointer; }
+button:hover { background: #1b5835; }
+#updated { color: #627066; margin-left: auto; }
+
+.modules { display: grid; gap: 12px; }
+.module { background: #fff; border: 1px solid #e2e8df; border-left: 5px solid #627066; border-radius: 8px; padding: 14px 16px; }
+.module[data-s="ok"] { border-left-color: #267447; }
+.module[data-s="down"] { border-left-color: #e08a1e; }
+.module[data-s="failed"] { border-left-color: #c0392b; }
+.module-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.module-head strong { font-size: 1.05rem; }
+.version, .latency { color: #627066; font-size: 0.8rem; }
+.desc { margin: 4px 0; color: #627066; font-size: 0.9rem; }
+.detail { margin: 4px 0; font-size: 0.85rem; }
+.detail.err { color: #c0392b; }
+
+.routes { list-style: none; margin: 8px 0 0; padding: 0; font-size: 0.85rem; }
+.routes li { display: flex; align-items: center; gap: 8px; padding: 4px 0; border-top: 1px solid #f0f3ee; }
+.method { font-family: monospace; font-weight: bold; color: #267447; min-width: 46px; }
+.path { font-family: monospace; }
+.routes .note { color: #627066; margin-left: auto; text-align: right; }
+.routes button { padding: 2px 10px; font-size: 0.8rem; }
+
+.response { background: #fff; border: 1px solid #e2e8df; border-radius: 8px; padding: 12px 16px; }
+#resMeta { font-size: 0.85rem; color: #627066; }
+#resBody { margin: 8px 0 0; max-height: 320px; overflow: auto; font-size: 0.8rem; background: #0e1a12; color: #7CFC9A; padding: 10px; border-radius: 6px; white-space: pre-wrap; word-break: break-word; }
+#resBody:empty { display: none; }
diff --git a/backend/public/dashboard.js b/backend/public/dashboard.js
new file mode 100644
index 0000000..e42bf07
--- /dev/null
+++ b/backend/public/dashboard.js
@@ -0,0 +1,124 @@
+const $ = (id) => document.getElementById(id);
+const REFRESH_MS = 5000;
+let timer = null;
+
+// Small DOM helper. Uses textContent only, so server text can never inject markup.
+function el(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+async function getJson(url) {
+  const start = performance.now();
+  const res = await fetch(url, { cache: "no-store" });
+  const text = await res.text();
+  let data;
+  try { data = JSON.parse(text); } catch { data = text; }
+  return { status: res.status, ok: res.ok, ms: Math.round(performance.now() - start), data };
+}
+
+function setOverall(state, text) {
+  const pill = $("overall");
+  pill.dataset.s = state;
+  pill.textContent = text;
+}
+
+function renderSystem(h) {
+  const items = [
+    ["Uptime", formatUptime(h.uptimeSec)],
+    ["Port", h.port],
+    ["Node", h.node],
+    ["Modules", `${h.modules.filter((m) => m.status === "ok").length} / ${h.modules.length} healthy`],
+  ];
+  $("system").replaceChildren(...items.map(([label, value]) => {
+    const box = el("div", "stat");
+    box.append(el("small", "", label), el("span", "", String(value)));
+    return box;
+  }));
+}
+
+function formatUptime(s) {
+  if (s < 60) return `${s}s`;
+  if (s < 3600) return `${Math.floor(s / 60)}m ${s % 60}s`;
+  return `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m`;
+}
+
+function renderModules(mods, checks) {
+  const byName = Object.fromEntries(checks.map((c) => [c.name, c]));
+  if (!mods.length) {
+    $("modules").replaceChildren(el("p", "desc", "No modules found. Add a folder to modules/."));
+    return;
+  }
+
+  $("modules").replaceChildren(...mods.map((m) => {
+    const check = byName[m.name] || { status: "down", detail: "no health result", latencyMs: 0 };
+    const card = el("div", "module");
+    card.dataset.s = check.status;
+
+    const head = el("div", "module-head");
+    const pill = el("span", "pill", check.status);
+    pill.dataset.s = check.status;
+    head.append(el("strong", "", m.name), pill);
+    if (m.version) head.append(el("span", "version", `v${m.version}`));
+    if (m.status === "loaded") head.append(el("span", "latency", `${check.latencyMs} ms`));
+    card.append(head);
+
+    if (m.description) card.append(el("p", "desc", m.description));
+    if (check.detail) card.append(el("p", check.status === "ok" ? "detail" : "detail err", check.detail));
+
+    if (m.routes.length) {
+      const list = el("ul", "routes");
+      for (const r of m.routes) {
+        const li = el("li");
+        li.append(el("span", "method", r.method), el("span", "path", r.path));
+        if (r.description) li.append(el("span", "note", r.description));
+        if (r.method === "GET") {
+          const btn = el("button", "", "Call");
+          btn.addEventListener("click", () => callRoute(r.path));
+          li.append(btn);
+        }
+        list.append(li);
+      }
+      card.append(list);
+    }
+    return card;
+  }));
+}
+
+async function callRoute(path) {
+  $("resMeta").textContent = `GET ${path} …`;
+  $("resBody").textContent = "";
+  try {
+    const r = await getJson(path);
+    $("resMeta").textContent = `GET ${path} → ${r.status} in ${r.ms} ms`;
+    $("resBody").textContent = typeof r.data === "string" ? r.data : JSON.stringify(r.data, null, 2);
+  } catch (e) {
+    $("resMeta").textContent = `GET ${path} failed: ${e.message}`;
+  }
+}
+
+async function refresh() {
+  try {
+    const [mods, health] = await Promise.all([getJson("/api/modules"), getJson("/api/health")]);
+    if (!mods.ok || !health.ok) throw new Error(`HTTP ${mods.ok ? health.status : mods.status}`);
+    setOverall(health.data.status, health.data.status === "ok" ? "all systems ok" : "degraded");
+    renderSystem(health.data);
+    renderModules(mods.data, health.data.modules);
+    $("updated").textContent = `Updated ${new Date().toLocaleTimeString()}`;
+  } catch (e) {
+    setOverall("unreachable", "backend unreachable");
+    $("updated").textContent = e.message;
+  }
+}
+
+function schedule() {
+  clearInterval(timer);
+  if ($("auto").checked) timer = setInterval(refresh, REFRESH_MS);
+}
+
+$("refresh").addEventListener("click", refresh);
+$("auto").addEventListener("change", schedule);
+refresh();
+schedule();

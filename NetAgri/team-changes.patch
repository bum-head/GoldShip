+// Throw this from a module handler to send a specific status code.
+class HttpError extends Error {
+  constructor(status, message) {
+    super(message);
+    this.status = status;
+  }
+}
+module.exports = { HttpError };
diff --git a/backend/core/health.js b/backend/core/health.js
new file mode 100644
index 0000000..e9e0166
--- /dev/null
+++ b/backend/core/health.js
@@ -0,0 +1,34 @@
+const config = require("./config");
+
+function withTimeout(promise, ms) {
+  let timer;
+  const timeout = new Promise((_, reject) => { timer = setTimeout(() => reject(new Error(`timed out after ${ms} ms`)), ms); });
+  return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
+}
+
+async function checkModule(m) {
+  if (m.status === "failed") return { name: m.name, status: "failed", detail: m.error, latencyMs: 0 };
+
+  const start = Date.now();
+  try {
+    const result = m.health ? await withTimeout(Promise.resolve(m.health()), config.HEALTH_TIMEOUT_MS) : { ok: true, detail: "no health check defined" };
+    return { name: m.name, status: result.ok ? "ok" : "down", detail: result.detail || "", latencyMs: Date.now() - start };
+  } catch (e) {
+    return { name: m.name, status: "down", detail: e.message, latencyMs: Date.now() - start };
+  }
+}
+
+// Runs every module's health check in parallel.
+async function runHealth(modules, startedAt) {
+  const checks = await Promise.all(modules.map(checkModule));
+  return {
+    status: checks.every((c) => c.status === "ok") ? "ok" : "degraded",
+    time: new Date().toISOString(),
+    uptimeSec: Math.round((Date.now() - startedAt) / 1000),
+    node: process.version,
+    port: config.PORT,
+    modules: checks,
+  };
+}
+
+module.exports = { runHealth };
diff --git a/backend/core/loader.js b/backend/core/loader.js
new file mode 100644
index 0000000..6c5e129
--- /dev/null
+++ b/backend/core/loader.js
@@ -0,0 +1,50 @@
+// Finds every folder in /modules, loads it, and checks it follows the module contract.
+// A broken module is recorded as "failed" instead of crashing the server.
+const fs = require("fs");
+const path = require("path");
+
+const NAME_RE = /^[a-z][a-z0-9-]*$/;
+const METHODS = ["GET", "POST", "PUT", "PATCH", "DELETE"];
+
+function validate(mod) {
+  if (!mod || typeof mod !== "object") throw new Error("module must export an object");
+  if (!NAME_RE.test(mod.name || "")) throw new Error('"name" must be lowercase letters, digits or dashes');
+  if (mod.health !== undefined && typeof mod.health !== "function") throw new Error('"health" must be a function');
+  if (mod.init !== undefined && typeof mod.init !== "function") throw new Error('"init" must be a function');
+  for (const r of mod.routes || []) {
+    if (!METHODS.includes(r.method)) throw new Error(`route method must be one of ${METHODS.join(", ")}`);
+    if (typeof r.path !== "string" || !r.path.startsWith("/")) throw new Error(`route path "${r.path}" must start with "/"`);
+    if (typeof r.handler !== "function") throw new Error(`route ${r.method} ${r.path} needs a handler function`);
+  }
+}
+
+async function loadModules(dir) {
+  const registry = [];
+  const entries = fs.readdirSync(dir, { withFileTypes: true })
+    .filter((e) => e.isDirectory() && !e.name.startsWith("_") && !e.name.startsWith("."))
+    .sort((a, b) => a.name.localeCompare(b.name));
+
+  for (const entry of entries) {
+    try {
+      const mod = require(path.join(dir, entry.name));
+      validate(mod);
+      if (registry.some((m) => m.name === mod.name)) throw new Error(`duplicate module name "${mod.name}"`);
+      if (mod.init) await mod.init();
+      registry.push({
+        name: mod.name,
+        description: mod.description || "",
+        version: mod.version || "0.0.0",
+        status: "loaded",
+        routes: mod.routes || [],
+        health: mod.health,
+      });
+      console.log(`  ✔ module loaded: ${mod.name}`);
+    } catch (e) {
+      registry.push({ name: entry.name, description: "", version: "", status: "failed", error: e.message, routes: [] });
+      console.error(`  ✘ module failed: ${entry.name} — ${e.message}`);
+    }
+  }
+  return registry;
+}
+
+module.exports = { loadModules };
